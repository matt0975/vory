<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Remote notifications for approvals, clarify prompts, finished turns and cron results.
	     Xcode rewrites this to "production" when archiving for TestFlight / the App Store.
	     Requires a paid Apple Developer Program membership; a free Personal Team cannot
	     provision it and signing will fail with "no profiles were found". -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Shared with the Live Activity / widgets and the watch app: gateways + widget snapshot. -->
	<!-- Notifications from a bot are presented as messages from it (its avatar as the icon). -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.vorantx.vory.shared</string>
	</array>
	<!-- iCloud key-value storage: settings and bot looks, the same on the person's devices.
	     The same value on iOS and the Mac, so they share one store. No CloudKit container. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.vorantx.vory</string>
</dict>
</plist>
